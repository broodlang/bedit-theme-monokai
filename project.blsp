;; bedit-theme-monokai — a Monokai colour theme for the bedit editor, a hive PLUGIN
;; package (`:enhances bedit`). Pure data; installed at runtime via M-x package-list.
(project
  :name "bedit-theme-monokai"
  :version "0.3.1"
  :description
    "The classic Monokai colour theme for the bedit editor — a plugin package (:enhances bedit)."
  :repository "https://github.com/broodlang/bedit-theme-monokai"
  :enhances {bedit ">= 0.4"}
  :source-paths ["src"])
